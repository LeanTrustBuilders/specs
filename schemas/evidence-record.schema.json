{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/LeanTrustBuilders/specs/schemas/evidence-record.schema.json",
 "title": "S3 evidence record (ltb-evidence/0)",
 "type": "object",
 "required": [
  "schema",
  "kind",
  "id",
  "by",
  "at"
 ],
 "properties": {
  "schema": {
   "const": "ltb-evidence/0"
  },
  "kind": {
   "enum": [
    "review",
    "comment",
    "status",
    "test",
    "challenge",
    "named"
   ]
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "subject": {
   "$ref": "#/$defs/subject"
  },
  "by": {
   "$ref": "#/$defs/by"
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "origin": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string"
    },
    "ref": {
     "type": "string"
    }
   }
  },
  "links": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "migration": {
   "type": "object"
  },
  "signature": {
   "type": [
    "string",
    "null"
   ]
  },
  "verdict": {
   "enum": [
    "accept",
    "problem",
    "question"
   ]
  },
  "problem": {
   "type": "object",
   "required": [
    "category"
   ],
   "properties": {
    "category": {
     "$ref": "#/$defs/category"
    }
   }
  },
  "rationale": {
   "type": "string"
  },
  "reference": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string"
    },
    "url": {
     "type": "string"
    }
   }
  },
  "checked": {
   "type": "object",
   "additionalProperties": {
    "enum": [
     "checked",
     "unchecked",
     "na"
    ]
   }
  },
  "caveats": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "category"
    ],
    "properties": {
     "category": {
      "$ref": "#/$defs/category"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "target": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "state": {
   "enum": [
    "fixed",
    "intended",
    "invalid",
    "answered",
    "met",
    "failed",
    "declined",
    "reopened",
    "withdrawn"
   ]
  },
  "test": {
   "type": "object",
   "required": [
    "name"
   ]
  },
  "checks": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "text": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "commit": {
   "type": "string"
  },
  "property": {
   "type": "string",
   "description": "challenge: what the subject should satisfy (Markdown)"
  },
  "statement": {
   "type": "string",
   "description": "challenge: the property as a Lean statement"
  },
  "catches": {
   "type": "string",
   "description": "challenge: what a failure would reveal"
  },
  "modes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/category"
   },
   "description": "challenge: the failure modes it would catch"
  },
  "fix": {
   "type": "string",
   "description": "problem: a suggested fix"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "enum": [
       "review",
       "test",
       "challenge",
       "named"
      ]
     }
    }
   },
   "then": {
    "required": [
     "subject"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "review"
     }
    }
   },
   "then": {
    "required": [
     "verdict"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "verdict": {
      "const": "problem"
     }
    }
   },
   "then": {
    "required": [
     "problem",
     "rationale"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "by": {
      "properties": {
       "kind": {
        "const": "agent"
       }
      }
     },
     "kind": {
      "const": "review"
     }
    }
   },
   "then": {
    "required": [
     "rationale"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "status"
     }
    }
   },
   "then": {
    "required": [
     "target",
     "state"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "comment"
     }
    }
   },
   "then": {
    "required": [
     "text",
     "links"
    ],
    "properties": {
     "links": {
      "required": [
       "replies_to"
      ]
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "challenge"
     }
    }
   },
   "then": {
    "required": [
     "property"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "test"
     }
    }
   },
   "then": {
    "required": [
     "test"
    ]
   }
  }
 ],
 "$defs": {
  "category": {
   "enum": [
    "F1",
    "F2",
    "F3",
    "F4",
    "F5",
    "F6",
    "F7",
    "F8",
    "F9",
    "naming",
    "other"
   ]
  },
  "subject": {
   "type": "object",
   "required": [
    "name",
    "commit"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "module": {
     "type": "string"
    },
    "package": {
     "type": "string"
    },
    "commit": {
     "type": "string"
    },
    "toolchain": {
     "type": "string"
    },
    "hasher": {
     "type": "object"
    },
    "hashes": {
     "type": "object"
    },
    "kind": {
     "enum": [
      "definition",
      "statement",
      "instance",
      "link",
      "text"
     ]
    }
   }
  },
  "by": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "person",
      "agent"
     ]
    },
    "identity": {
     "type": "object",
     "required": [
      "kind",
      "id"
     ],
     "properties": {
      "kind": {
       "const": "github"
      },
      "id": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "agent": {
     "type": "object",
     "required": [
      "tool"
     ],
     "properties": {
      "tool": {
       "type": "string",
       "minLength": 1
      },
      "model": {
       "type": "string"
      },
      "session": {
       "type": "string"
      }
     }
    },
    "involvement": {
     "enum": [
      "author",
      "contributor",
      "outsider",
      "unknown"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "person"
       }
      }
     },
     "then": {
      "required": [
       "identity"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "agent"
       }
      }
     },
     "then": {
      "required": [
       "agent"
      ]
     }
    }
   ]
  }
 }
}