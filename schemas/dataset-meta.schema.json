{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeanTrustBuilders/specs/schemas/dataset-meta.schema.json",
  "title": "S2 dataset meta.json (ltb-dataset/1; ltb-dataset/0 is still read)",
  "type": "object",
  "required": ["spec", "producer", "library", "toolchain", "hasher", "counts", "edges", "facets"],
  "properties": {
    "spec": {"enum": ["ltb-dataset/1", "ltb-dataset/0"]},
    "producer": {"type": "object", "required": ["name", "version"],
                 "properties": {"name": {"type": "string"}, "version": {"type": "string"},
                                "parts": {"type": "integer", "minimum": 1}}},
    "library": {"type": "object", "required": ["root", "package", "commit"],
                "properties": {"root": {"type": "string"}, "package": {"type": "string"},
                               "repo": {"type": "string"}, "commit": {"type": "string"},
                               "dirty": {"type": "boolean"}, "modules": {"type": "integer"},
                               "unavailable": {"type": "array", "items": {"type": "string"}}}},
    "toolchain": {"type": "string"},
    "lean": {"type": "object"},
    "hasher": {"$ref": "#/$defs/hasher"},
    "counts": {"type": "object", "required": ["nodes", "project", "upstream"],
               "additionalProperties": {"type": "integer", "minimum": 0}},
    "edges": {"type": "array", "items": {"type": "object",
              "required": ["name", "file", "format", "count"],
              "properties": {"name": {"type": "string"}, "file": {"type": "string"},
                             "format": {"const": "i32le-pairs"},
                             "count": {"type": "integer", "minimum": 0},
                             "description": {"type": "string"}}}},
    "modules": {"type": "object", "required": ["file", "count"],
                "properties": {"file": {"type": "string"}, "count": {"type": "integer", "minimum": 0}}},
    "packages": {"type": "array", "items": {"type": "object", "required": ["name", "modules", "requires"],
                 "properties": {"name": {"type": "string"},
                                "modules": {"type": "integer", "minimum": 0},
                                "requires": {"type": "array", "items": {"type": "string"}}}}},
    "facets": {"type": "array", "items": {"type": "object",
               "required": ["name", "file", "schema", "count"],
               "properties": {"name": {"type": "string"}, "file": {"type": "string"},
                              "schema": {"type": "string", "pattern": "^[a-z_.]+/[0-9]+$"},
                              "count": {"type": "integer", "minimum": 0},
                              "description": {"type": "string"}}}}
  },
  "$defs": {
    "semanticHash": {"type": "object", "required": ["name", "revision"],
                     "properties": {"name": {"const": "semantic_hash"},
                                    "revision": {"type": ["string", "null"]},
                                    "variant": {"type": "string"}, "meaning": {"type": "string"},
                                    "local": {"type": ["string", "null"]}}},
    "hasher": {"oneOf": [
      {"description": "ltb-dataset/1: the rule's meaning and local hashes, semantic_hash's content hash, and the hashes of ltb-dataset/0 as legacy",
       "type": "object", "required": ["name", "meaning", "local", "content", "legacy"],
       "properties": {"name": {"type": "string", "pattern": "^ltb-meaning/"},
                      "meaning": {"type": "string"}, "local": {"type": "string"},
                      "content": {"$ref": "#/$defs/semanticHash"},
                      "legacy": {"$ref": "#/$defs/semanticHash"}}},
      {"description": "ltb-dataset/0: semantic_hash's hashes, and the local hash ltb-local-v1",
       "type": "object", "required": ["name", "revision", "local"],
       "properties": {"name": {"const": "semantic_hash"},
                      "revision": {"type": ["string", "null"]},
                      "meaning": {"type": "string"}, "content": {"type": "string"},
                      "local": {"type": ["string", "null"]}}}]}
  }
}
