{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeanTrustBuilders/specs/schemas/decl.schema.json",
  "title": "One line of decls.jsonl (ltb-dataset/1)",
  "type": "object",
  "required": ["id", "name", "module", "package", "scope", "kind", "isProp", "hashes"],
  "properties": {
    "id": {"type": "integer", "minimum": 0},
    "name": {"type": "string"},
    "module": {"type": "string"},
    "package": {"type": "string"},
    "scope": {"enum": ["project", "upstream"]},
    "kind": {"enum": ["theorem", "definition", "instance", "class", "structure", "inductive",
                      "axiom", "opaque", "constructor", "recursor", "quotient"]},
    "isProp": {"type": "boolean"},
    "hashes": {"$ref": "#/$defs/hashes"}
  },
  "$defs": {
    "hex16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "hashes": {"type": "object", "required": ["local"],
               "properties": {"meaning": {"$ref": "#/$defs/hex16"},
                              "content": {"$ref": "#/$defs/hex16"},
                              "local": {"$ref": "#/$defs/hex16"},
                              "legacy": {"type": "object", "description": "ltb-dataset/1: the meaning and local hashes of ltb-dataset/0",
                                         "properties": {"meaning": {"$ref": "#/$defs/hex16"},
                                                        "local": {"$ref": "#/$defs/hex16"}}}}}
  }
}
