{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/LeanTrustBuilders/specs/schemas/evidence-record.schema.json",
 "title": "S3 evidence record (ltb-evidence/1)",
 "description": "Readers ignore fields they do not know (S3, Compatibility): no object here forbids others.",
 "type": "object",
 "required": [
  "schema",
  "kind",
  "id",
  "by",
  "at"
 ],
 "properties": {
  "schema": {
   "const": "ltb-evidence/1"
  },
  "kind": {
   "enum": [
    "review",
    "comment",
    "status",
    "test",
    "challenge",
    "named"
   ]
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "subject": {
   "$ref": "#/$defs/subject"
  },
  "text": {
   "type": "string",
   "description": "the record's words, in Markdown"
  },
  "by": {
   "$ref": "#/$defs/by"
  },
  "at": {
   "type": "string",
   "format": "date-time"
  },
  "origin": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string"
    },
    "ref": {
     "type": "string"
    }
   }
  },
  "links": {
   "type": "object",
   "properties": {
    "supersedes": {
     "type": "string",
     "pattern": "^[0-9a-f]{16}$"
    },
    "replies_to": {
     "type": "string",
     "pattern": "^[0-9a-f]{16}$"
    }
   }
  },
  "migration": {
   "type": "object"
  },
  "signature": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "enum": [
       "review",
       "test",
       "challenge",
       "named"
      ]
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "required": [
     "subject"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "review"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "verdict": {
      "enum": [
       "accept",
       "problem",
       "question"
      ]
     },
     "category": {
      "$ref": "#/$defs/category"
     },
     "reference": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      }
     },
     "checked": {
      "type": "object",
      "additionalProperties": {
       "enum": [
        "checked",
        "unchecked",
        "na"
       ]
      }
     },
     "caveats": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "category"
       ],
       "properties": {
        "category": {
         "$ref": "#/$defs/category"
        },
        "note": {
         "type": "string"
        }
       }
      }
     },
     "fix": {
      "type": "string"
     }
    },
    "required": [
     "verdict"
    ],
    "allOf": [
     {
      "if": {
       "properties": {
        "verdict": {
         "const": "problem"
        }
       },
       "required": [
        "verdict"
       ]
      },
      "then": {
       "required": [
        "category",
        "text"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "by": {
         "properties": {
          "kind": {
           "const": "agent"
          }
         }
        }
       }
      },
      "then": {
       "required": [
        "text"
       ]
      }
     }
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "comment"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "links": {
      "required": [
       "replies_to"
      ]
     }
    },
    "required": [
     "text",
     "links"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "status"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "target": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
     },
     "state": {
      "enum": [
       "fixed",
       "intended",
       "invalid",
       "answered",
       "met",
       "failed",
       "declined",
       "reopened",
       "withdrawn"
      ]
     },
     "commit": {
      "type": "string"
     },
     "test": {
      "type": "object",
      "required": [
       "name"
      ],
      "properties": {
       "name": {
        "type": "string"
       }
      }
     }
    },
    "required": [
     "target",
     "state"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "test"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "test": {
      "type": "object",
      "required": [
       "name"
      ],
      "properties": {
       "name": {
        "type": "string"
       }
      }
     }
    },
    "required": [
     "test"
    ],
    "allOf": [
     {
      "if": {
       "properties": {
        "by": {
         "properties": {
          "kind": {
           "const": "agent"
          }
         }
        }
       }
      },
      "then": {
       "required": [
        "text"
       ]
      }
     }
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "challenge"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "statement": {
      "type": "string"
     },
     "catches": {
      "type": "string"
     },
     "modes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/category"
      }
     }
    },
    "required": [
     "text"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "named"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "name": {
      "type": "string"
     },
     "what": {
      "enum": [
       "result",
       "definition"
      ]
     },
     "reference": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      }
     }
    },
    "required": [
     "name"
    ]
   }
  }
 ],
 "$defs": {
  "category": {
   "enum": [
    "F1",
    "F2",
    "F3",
    "F4",
    "F5",
    "F6",
    "F7",
    "F8",
    "F9",
    "naming",
    "other"
   ]
  },
  "subject": {
   "type": "object",
   "required": [
    "name",
    "commit"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "module": {
     "type": "string"
    },
    "package": {
     "type": "string"
    },
    "commit": {
     "type": "string"
    },
    "toolchain": {
     "type": "string"
    },
    "hasher": {
     "type": "object",
     "properties": {
      "meaning": {
       "type": "string",
       "pattern": "^ltb-meaning/"
      },
      "local": {
       "type": "string",
       "pattern": "^ltb-local/"
      }
     }
    },
    "hashes": {
     "type": "object",
     "properties": {
      "meaning": {
       "type": "string",
       "pattern": "^[0-9a-f]{16}$"
      },
      "local": {
       "type": "string",
       "pattern": "^[0-9a-f]{16}$"
      }
     }
    },
    "aspect": {
     "enum": [
      "definition",
      "statement",
      "instance"
     ]
    }
   }
  },
  "by": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "person",
      "agent"
     ]
    },
    "identity": {
     "type": "object",
     "required": [
      "kind",
      "id"
     ],
     "properties": {
      "kind": {
       "const": "github"
      },
      "id": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "agent": {
     "type": "object",
     "required": [
      "tool"
     ],
     "properties": {
      "tool": {
       "type": "string",
       "minLength": 1
      },
      "model": {
       "type": "string"
      },
      "session": {
       "type": "string"
      }
     }
    },
    "involvement": {
     "enum": [
      "author",
      "contributor",
      "outsider",
      "unknown"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "person"
       }
      }
     },
     "then": {
      "required": [
       "identity"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "agent"
       }
      }
     },
     "then": {
      "required": [
       "agent"
      ]
     }
    }
   ]
  }
 }
}
